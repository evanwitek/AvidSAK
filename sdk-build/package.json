{
  "name": "mediafolderpanel-sdk-build",
  "version": "0.0.1",
  "private": true,
  "description": "Bundles the PanelSDK gRPC-web files into ../panel/sdk/mcapi-bundle.js",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --target=chrome87 --format=iife --outfile=../panel/sdk/mcapi-bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "google-protobuf": "~3.14.0",
    "grpc-web": "~1.3.0"
  }
}
